# Docker Compose shared configuration (CUDA and Ascend)
# Match these IDs to the host account that owns the bind-mounted directories.
# Check them with `id -u` and `id -g`; changing them requires rebuilding the image.
APP_UID=1002
APP_GID=1003

# Prefer an absolute host path so both Compose entrypoints resolve the same model store.
MODEL_STORE_HOST_PATH=/data/models
GATEWAY_WORKERS=2
SERVE_READY_TIMEOUT_SECONDS=900

# Compose normally discovers the Ray head through the `ray-head` service name.
# Set this only when connecting to a different Ray cluster endpoint.
# INFER_NEXUS_RAY_ADDRESS=ray-head:6379

# CUDA-only configuration
CUDA_VISIBLE_DEVICES=0,1,2,3

# Ascend-only configuration
# Base image must provide a compatible Python, Ray Serve, torch-npu, vLLM,
# and vLLM-Ascend runtime stack.
ASCEND_BASE_IMAGE=mineru:npu-latest

# Required by ascend_deploy/docker-compose.yml. This defines the NPU pool that
# the infer-nexus Ray worker can see and from which it derives the logical NPU count.
ASCEND_RT_VISIBLE_DEVICES=0,1,2,3

# Keep the explicitly configured Ascend visibility mask instead of allowing Ray
# to rewrite ASCEND_RT_VISIBLE_DEVICES for worker processes.
RAY_EXPERIMENTAL_NOSET_ASCEND_RT_VISIBLE_DEVICES=1
