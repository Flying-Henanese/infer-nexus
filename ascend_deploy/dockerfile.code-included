# syntax=docker/dockerfile:1

# 910B 平台归档变体 Dockerfile：以 ascend_deploy/dockerfile 为基准，额外把仓库代码
# （src/scripts/docs/config）打进镜像，运行时不再依赖宿主机代码 bind 挂载，仅保留
# 模型目录（/models）与 Ascend 驱动相关挂载。基础镜像与依赖安装流程与基准完全一致，
# 因此可复用已有构建缓存；代码 COPY 置于末尾层，代码变动只重建尾部层。
# 如果部署侧换成 vLLM 官方昇腾镜像，可以通过 ASCEND_BASE_IMAGE 覆盖；镜像内自带的
# Python / torch / vLLM / vLLM-Ascend 栈必须保持不被覆盖。
ARG ASCEND_BASE_IMAGE=quay.io/ascend/vllm-ascend:v0.23.0
ARG UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ARG APP_USER=infer-nexus
ARG APP_UID=10001
ARG APP_GID=10001

FROM ${ASCEND_BASE_IMAGE} AS runtime

ARG UV_INDEX_URL
ARG APP_USER
ARG APP_UID
ARG APP_GID

# 使用基础镜像自带的系统 Python，不创建项目虚拟环境，也不改写 PATH 到 /app/.venv。
# PYTHONPATH 负责让镜像内置的 /app/src 代码可导入。
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app/src \
    HOME=/home/${APP_USER} \
    XDG_CACHE_HOME=/home/${APP_USER}/.cache \
    HF_HOME=/home/${APP_USER}/.cache/huggingface \
    VLLM_CACHE_ROOT=/home/${APP_USER}/.cache/vllm \
    MODELSCOPE_CACHE=/home/${APP_USER}/.cache/modelscope \
    RAY_TMPDIR=/tmp/ray \
    UV_INDEX_URL=${UV_INDEX_URL}

# Install monitoring/profiling helpers used by Ascend benchmark runs.
# CANN, npu-smi, hccn_tool, msprof, and msopprof are provided by the Ascend
# base image or by host-mounted driver/toolkit paths.
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        gnupg \
        jq \
        sysstat \
    && for package in \
        prometheus \
        prometheus-node-exporter \
        prometheus-process-exporter \
        grafana \
        grafana-server; do \
        if apt-cache show "${package}" >/dev/null 2>&1; then \
            apt-get install -y --no-install-recommends "${package}"; \
        else \
            echo "Skipping unavailable apt package: ${package}"; \
        fi; \
    done \
    && if [ -f /etc/default/sysstat ]; then \
        sed -i 's/^ENABLED=.*/ENABLED="true"/' /etc/default/sysstat; \
    fi \
    && rm -rf /var/lib/apt/lists/*

# 设置工作目录。
WORKDIR /app

# 本地的 pyproject.ascend.toml 复制到容器内并重命名为 pyproject.toml。
# 满足 uv 导出和安装依赖时需要的 README.md 文件。
COPY pyproject.ascend.toml ./pyproject.toml
COPY README.md ./

# 配置 uv 使用镜像源，加速依赖安装过程。
# 先从 Ascend 版 pyproject 导出 requirements.txt，再删除 vLLM 昇腾镜像已经提供的运行时包。
# 这些包包括 torch / torch-npu / torchaudio / torchvision / transformers / vLLM / vLLM-Ascend，不能由项目安装覆盖。
# 添加huggingface-hub去除，同样不能覆盖安装
RUN python -m pip install --no-cache-dir uv -i ${UV_INDEX_URL} \
    && uv pip compile pyproject.toml \
        --extra artifacts \
        --output-file requirements.txt \
    && sed -i -E '/^(torch|torch-npu|torchaudio|torchvision|transformers|vllm|vllm-ascend|huggingface-hub|fastapi|starlette|uvicorn|httpx|anyio|pydantic|ray)([[:space:]=<>!~]|$)/Id' requirements.txt \
    && uv pip install --system --no-cache -r requirements.txt

RUN groupadd --gid ${APP_GID} ${APP_USER} \
    && useradd --uid ${APP_UID} --gid ${APP_GID} --create-home --home-dir /home/${APP_USER} --shell /usr/sbin/nologin ${APP_USER} \
    && mkdir -p /app /models /tmp/ray /home/${APP_USER}/.cache/huggingface /home/${APP_USER}/.cache/modelscope /home/${APP_USER}/.cache/vllm \
    && chown -R ${APP_UID}:${APP_GID} /app /models /tmp/ray /home/${APP_USER}

# vllm-ascend 自定义算子包默认以 root 权限安装，非 root 运行用户加载 vendor 算子会被拒
RUN chmod -R a+rX /vllm-workspace/vllm-ascend/vllm_ascend/_cann_ops_custom

# 归档代码：把运行所需代码打进镜像。构建上下文为仓库根（与 ascend_deploy/dockerfile
# 的两个变体一致），README.md 与 pyproject.ascend.toml 已在前面 COPY。
COPY --chown=${APP_UID}:${APP_GID} src/ ./src/
COPY --chown=${APP_UID}:${APP_GID} scripts/ ./scripts/
COPY --chown=${APP_UID}:${APP_GID} docs/ ./docs/
COPY --chown=${APP_UID}:${APP_GID} config/ ./config/

USER ${APP_USER}

EXPOSE 8000 8265
